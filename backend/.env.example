PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/motoguard?sslmode=disable
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
FRONTEND_URL=https://mxguard.jullie.tech
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=no-reply@jullie.tech
MAILJET_REPLY_TO_EMAIL=hello@jullie.tech
LOG_FILE=/var/log/fleet/fleet.log

# AWS SNS Push & SMS Notifications
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_PLATFORM_APP_ARN=arn:aws:sns:eu-west-1:123456789012:app/GCM/motorguard-fcm
AWS_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:123456789012:motorguard-alerts
