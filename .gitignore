# ======================================================================
#                       MOTOGUARD GITIGNORE
# ======================================================================

# Database dumps & SQL exports
*.sql
**/*.sql
*.dump
*.sql.gz
*.psql
*.sqlite
*.sqlite3
*.db

# Agent instructions & specifications
agent.md
*agent*.md
**/*agent*.md
skills.md
deliverables.md
SRS-Addendum*.md

# Environment & Sensitive configs
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs & monitoring
*.log
**/*.log
logs/
**/logs/
mosquitto/log/
mosquitto/data/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Helper scripts & temporary working files
scripts/
**/scripts/
scratch/
**/scratch/
tmp/
**/tmp/
temp/
**/temp/
*.sh
*.bash
*.zsh

# Sensitive keys, certificates & credentials
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.kdbx
secrets/
**/secrets/
credentials/
**/credentials/
id_rsa*
id_ed25519*
*.secret
*.passwd
*.htpasswd

# Node & Angular
node_modules/
**/node_modules/
.angular/
**/.angular/
dist/
**/dist/

# Backend binaries & build artifacts
server
**/server
*.exe
*.test
*.out
*.zip
*.tar.gz
/vendor/

# System & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
