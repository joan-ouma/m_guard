# ======================================================================
#                       MOTOGUARD GITIGNORE
# ======================================================================

# Database dumps & SQL exports
*.dump
*.sql.gz
*.psql
*.sqlite
*.sqlite3
*.db

# Environment & Sensitive configs
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs & monitoring
*.log
**/*.log
logs/
**/logs/
mosquitto/log/
mosquitto/data/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Helper scripts & temporary working files
scripts/
**/scripts/
!frontend/scripts/
scratch/
**/scratch/
tmp/
**/tmp/
temp/
**/temp/
*.sh
*.bash
*.zsh

# Sensitive keys, certificates & credentials
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.kdbx
secrets/
**/secrets/
credentials/
**/credentials/
id_rsa*
id_ed25519*
*.secret
*.passwd
*.htpasswd

# Node & Angular
node_modules/
**/node_modules/
.angular/
**/.angular/
dist/
**/dist/
frontend/src/environments/environment.ts
frontend/src/environments/environment.prod.ts
!frontend/src/environments/environment.example.ts

# Backend binaries & build artifacts
backend/server
*.exe
*.test
*.out
/vendor/
go.work
go.work.sum

# System & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
